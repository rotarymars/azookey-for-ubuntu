    def model_labels(self):
        path = self.settings.get("zenzaiLocalModelPath", "")
        local = f"自分のモデル — {Path(path).name}" if path else "自分のモデル (ローカルファイルを選ぶ)"
        return [self.model_label(model) for model in self.catalog] + [local]

    def local_model_ready(self):
        path = self.settings.get("zenzaiLocalModelPath", "")
        return bool(path) and Path(path).is_file()

    def update_local_rows(self):
        local = self.model_index == len(self.catalog)
        path = self.settings.get("zenzaiLocalModelPath", "")
        if not path:
            subtitle = "未選択"
        elif Path(path).is_file():
            subtitle = path
        else:
            subtitle = f"{path} (見つかりません。既定のモデルを使います)"
        self.local_file_row.set_subtitle(GLib.markup_escape_text(subtitle))
        self.local_file_row.set_visible(local)
        self.local_right_context_row.set_visible(local)
        self.update_row.set_visible(self.model_index < len(self.catalog) and outdated(self.catalog[self.model_index]))

    @staticmethod
    def model_label(model):
        location = installed_location(model)
        if location is None:
            status = f"ダウンロード {model['size'] / 1_000_000:.0f} MB"
        elif outdated(model):
            status = "ダウンロード済み・更新あり"
        elif location == user_models_directory():
            status = "ダウンロード済み"
        else:
            status = "同梱"
        return f"{model['label']} — {status}"

    def select_model_quietly(self, index):
        self.updating_models = True
        self.model_list.splice(0, self.model_list.get_n_items(), self.model_labels())
        self.rows["zenzaiModel"].set_selected(index)
        self.updating_models = False
        self.update_local_rows()

    def on_model_selected(self, row, _):
        index = row.get_selected()
        if self.updating_models or index == self.model_index or index > len(self.catalog):
            return
        if index == len(self.catalog):
            if self.local_model_ready():
                self.model_index = index
                self.set_value("zenzaiModel", LOCAL_MODEL)
                self.update_local_rows()
            else:
                # Keep the current model selected until a file is chosen.
                self.select_model_quietly(self.model_index)
                self.choose_local_model()
            return
        model = self.catalog[index]
        if installed_location(model) is not None:
            self.model_index = index
            self.set_value("zenzaiModel", model["id"])
            self.update_local_rows()
            return
        # Keep the current model selected until the download has finished.
        self.select_model_quietly(self.model_index)
        self.confirm_download(model, index)

    def choose_local_model(self):
        gguf = Gtk.FileFilter(name="GGUF モデル (*.gguf)")
        gguf.add_pattern("*.gguf")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(gguf)
        dialog = Gtk.FileDialog(title="zenz モデルのファイルを選ぶ", filters=filters, default_filter=gguf)
        current = self.settings.get("zenzaiLocalModelPath", "")
        if current and Path(current).parent.is_dir():
            dialog.set_initial_folder(Gio.File.new_for_path(str(Path(current).parent)))

        def finished(dialog, result):
            try:
                file = dialog.open_finish(result)
            except GLib.Error:  # dismissed
                return
            if file is not None and file.get_path():
                self.use_local_model(file.get_path())

        dialog.open(self, None, finished)

    def use_local_model(self, path):
        """Selects a GGUF file of the user's own. Returns whether it was accepted."""
        path = str(Path(path).resolve())
        if not is_gguf(path):
            self.toasts.add_toast(Adw.Toast(title=f"GGUF ファイルではありません: {Path(path).name}"))
            return False
        self.set_value("zenzaiLocalModelPath", path)
        self.model_index = len(self.catalog)
        self.select_model_quietly(self.model_index)
        self.set_value("zenzaiModel", LOCAL_MODEL)
        self.toasts.add_toast(Adw.Toast(title=f"{Path(path).name} を使います (次の入力から)"))
        return True

    def confirm_download(self, model, index):
        host = urllib.parse.urlsplit(model_url(model)).hostname
        body = f"{model['size'] / 1_000_000:.0f} MB を {host} からダウンロードします。ライセンス: {model['license']}"
        if model["license"] != "Apache-2.0":
            body += "\nほかの人に配布する場合は CC BY-SA 4.0 に従ってください。"
        dialog = Adw.AlertDialog(heading=f"{model['label']} をダウンロードしますか？", body=body)
        dialog.add_response("cancel", "キャンセル")
        dialog.add_response("download", "ダウンロード")
        dialog.set_response_appearance("download", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("download")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, response: response == "download" and self.start_download(model, index))
        dialog.present(self)

    def start_download(self, model, index):
        self.cancel_download = threading.Event()
        self.rows["zenzaiModel"].set_sensitive(False)
        self.download_row.set_title(f"{model['label']} をダウンロード中")
        self.download_bar.set_fraction(0)
        self.download_row.set_visible(True)
        last_percent = [-1]

        def progress(done, total):
            percent = done * 100 // max(total, 1)
            if percent != last_percent[0]:
                last_percent[0] = percent
                GLib.idle_add(self.show_progress, done, total)

        def work(cancelled):
            try:
                download_model(model, progress, cancelled)
                GLib.idle_add(self.download_finished, model, index, None)
            except Exception as error:  # reported in the window
                GLib.idle_add(self.download_finished, model, index, error)

        threading.Thread(target=work, args=(self.cancel_download,), daemon=True).start()

    def show_progress(self, done, total):
        self.download_bar.set_fraction(done / max(total, 1))
        self.download_bar.set_text(f"{done / 1_000_000:.0f} / {total / 1_000_000:.0f} MB")
        return GLib.SOURCE_REMOVE

    def download_finished(self, model, index, error):
        self.cancel_download = None
        self.download_row.set_visible(False)
        self.rows["zenzaiModel"].set_sensitive(True)
        if error is None:
            updated = index == self.model_index
            self.model_index = index
            self.select_model_quietly(index)
            self.set_value("zenzaiModel", model["id"])
            self.update_local_rows()
            # The engine keeps the file it loaded; a new file at the same path needs a restart.
            title = (f"{model['label']} を更新しました。ログインし直すか ibus restart を実行すると切り替わります"
                     if updated else f"{model['label']} を使います (次の入力から)")
            self.toasts.add_toast(Adw.Toast(title=title))
        else:
            self.select_model_quietly(self.model_index)
            message = "キャンセルしました" if isinstance(error, DownloadCancelled) else f"ダウンロードできませんでした: {error}"
            self.toasts.add_toast(Adw.Toast(title=message))
        return GLib.SOURCE_REMOVE

    # Rows are connected after their initial value is set, so building the
    # window never writes the file.

    def switch_row(self, key, title, subtitle=""):
        row = Adw.SwitchRow(title=title, subtitle=subtitle, active=bool(self.settings.get(key)))
        row.connect("notify::active", lambda widget, _: self.set_value(key, widget.get_active()))
        self.rows[key] = row
        return row

    def combo_row(self, key, title, choices):
        values = [value for value, _ in choices]
        row = Adw.ComboRow(title=title, model=Gtk.StringList.new([label for _, label in choices]))
        if self.settings.get(key) in values:
            row.set_selected(values.index(self.settings[key]))
        row.connect("notify::selected", lambda widget, _: self.set_value(key, values[widget.get_selected()]))
        self.rows[key] = row
        return row

    def spin_row(self, key, title, lower, upper, subtitle=""):
        row = Adw.SpinRow.new_with_range(lower, upper, 1)
        row.set_title(title)
        row.set_subtitle(subtitle)
        row.set_value(self.settings.get(key, lower))
        row.connect("notify::value", lambda widget, _: self.set_value(key, int(widget.get_value())))
        self.rows[key] = row
        return row

    def entry_row(self, key, title):
        row = Adw.EntryRow(title=title, show_apply_button=True, text=self.settings.get(key, ""))
        row.connect("apply", lambda widget: self.set_value(key, widget.get_text().strip()))
        self.rows[key] = row
        return row

    def set_value(self, key, value):
        if self.settings.get(key) == value:
            return
        self.settings[key] = value
        try:
            save_settings(self.settings)
        except OSError as error:
            self.toasts.add_toast(Adw.Toast(title=f"保存できませんでした: {error}"))

    def on_reset_clicked(self, _button):
        dialog = Adw.AlertDialog(
            heading="学習データをリセットしますか？",
            body="これまでに覚えた変換候補の順位がすべて消えます。元には戻せません。",
        )
        dialog.add_response("cancel", "キャンセル")
        dialog.add_response("reset", "リセット")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", self.on_reset_response)
        dialog.present(self)

    def on_reset_response(self, _dialog, response):
        if response != "reset":
            return
        self.request_learning_reset()
        self.toasts.add_toast(Adw.Toast(title="次に文字を入力するときに学習データがリセットされます"))

    @staticmethod
    def request_learning_reset():
        request = reset_request_file()
        request.parent.mkdir(parents=True, exist_ok=True)
        request.touch()


def self_test(application):
    window = SettingsWindow(application)
    assert not config_file().exists(), "building the window must not write settings"
    window.rows["learning"].set_selected(2)
    window.rows["liveConversion"].set_active(not window.rows["liveConversion"].get_active())
    window.rows["zenzaiInferenceLimit"].set_value(3)
    window.rows["typoCorrection"].set_active(not window.rows["typoCorrection"].get_active())
    saved = json.loads(config_file().read_text(encoding="utf-8"))
    assert saved["learning"] == "nothing", saved
    assert saved["zenzaiInferenceLimit"] == 3, saved
    assert saved["typoCorrection"] == window.rows["typoCorrection"].get_active(), saved
    SettingsWindow.request_learning_reset()
    assert reset_request_file().exists()

    # Model selector: every catalog model is listed; picking an installed one
    # saves it, picking a missing one keeps the current model (and would ask
    # before downloading).
    models = window.rows["zenzaiModel"]
    ids = [model["id"] for model in window.catalog]
    assert "zenz-v3.2-small" in ids and "zenz-v3.2-xsmall" in ids, ids
    fake = user_models_directory() / "zenz-v3.2-xsmall"
    fake.mkdir(parents=True)
    (fake / MODEL_FILE).write_bytes(b"")
    window.select_model_quietly(window.model_index)
    assert "ダウンロード済み" in window.model_list.get_string(ids.index("zenz-v3.2-xsmall"))
    models.set_selected(ids.index("zenz-v3.2-xsmall"))
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiModel"] == "zenz-v3.2-xsmall"
    confirmed = []
    window.confirm_download = lambda model, index: confirmed.append(model["id"])
    models.set_selected(ids.index("zenz-v3.1-small"))
    assert models.get_selected() == ids.index("zenz-v3.2-xsmall"), "a missing model must not be selected yet"
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiModel"] == "zenz-v3.2-xsmall"
    assert confirmed == ["zenz-v3.1-small"], confirmed
    # A download whose SOURCE records another SHA-256 than the catalog's is
    # outdated: the list says so and the update row offers the new file.
    xsmall = window.catalog[ids.index("zenz-v3.2-xsmall")]
    assert not outdated(xsmall) and not window.update_row.get_visible()
    (fake / "SOURCE").write_text(model_source(xsmall), encoding="utf-8")
    window.select_model_quietly(window.model_index)
    assert not outdated(xsmall) and not window.update_row.get_visible()
    (fake / "SOURCE").write_text(model_source({**xsmall, "sha256": "0" * 64}), encoding="utf-8")
    window.select_model_quietly(window.model_index)
    assert outdated(xsmall) and "更新あり" in window.model_list.get_string(ids.index("zenz-v3.2-xsmall"))
    assert window.update_row.get_visible()
    window.update_button.emit("clicked")
    assert confirmed[-1] == "zenz-v3.2-xsmall", confirmed
    (fake / "SOURCE").unlink()
    window.select_model_quietly(window.model_index)
    assert not window.update_row.get_visible()
    # Entries download from Hugging Face unless they give their own "url".
    for model in window.catalog:
        url = model_url(model)
        assert url.startswith("https://") and url.endswith(model["file"]), url
    assert model_url(window.catalog[0]).startswith("https://huggingface.co/")

    # Local model: listed last; choosing it without a file opens the file
    # chooser and keeps the current model; a GGUF file is accepted, others not.
    local_index = len(ids)
    assert "自分のモデル" in window.model_list.get_string(local_index)
    assert not window.local_file_row.get_visible()
    chooser_opened = []
    window.choose_local_model = lambda: chooser_opened.append(True)
    models.set_selected(local_index)
    assert chooser_opened and models.get_selected() == ids.index("zenz-v3.2-xsmall")
    not_gguf = user_models_directory() / "notes.gguf"
    not_gguf.write_bytes(b"hello")
    assert not window.use_local_model(not_gguf)
    mine = user_models_directory() / "my-zenz.gguf"
    mine.write_bytes(b"GGUF\x03\x00\x00\x00")
    assert window.use_local_model(mine)
    saved = json.loads(config_file().read_text(encoding="utf-8"))
    assert saved["zenzaiModel"] == LOCAL_MODEL and saved["zenzaiLocalModelPath"] == str(mine.resolve()), saved
    assert models.get_selected() == local_index and "my-zenz.gguf" in window.model_list.get_string(local_index)
    assert window.local_file_row.get_visible() and window.local_right_context_row.get_visible()
    window.local_right_context_row.set_active(True)
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiLocalModelRightContext"] is True
    models.set_selected(ids.index("zenz-v3.2-xsmall"))
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiModel"] == "zenz-v3.2-xsmall"
    assert not window.local_file_row.get_visible()
    models.set_selected(local_index)  # the file is known now: no chooser
    assert len(chooser_opened) == 1
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiModel"] == LOCAL_MODEL

    # Version row: the engine next to this script reports it (none in the source tree).
    version = window.version_label.get_label()
    if ENGINE.exists():
        assert re.fullmatch(r"\d+(\.\d+)+", version), f"version row shows {version!r}"
    # A running program whose file was replaced, as an upgrade does, counts as outdated.
    program = Path(tempfile.mkdtemp()).resolve() / "sleep"
    shutil.copy(shutil.which("sleep"), program)
    process = subprocess.Popen([str(program), "30"])
    try:
        assert not outdated_engine_running(program)
        program.unlink()
        assert outdated_engine_running(program), "a replaced running program must count as outdated"
    finally:
        process.kill()
        process.wait()
        shutil.rmtree(program.parent)
    print(f"self-test ok: {len(window.rows)} settings rows, {len(ids)} models, version {version}")
    shutil.rmtree(config_file().parent)
    application.quit()


def download_from_command_line(model_id):
    model = next((m for m in load_catalog() if m["id"] == model_id), None)
    if model is None:
        print(f"unknown model {model_id}; choose from: {', '.join(m['id'] for m in load_catalog())}", file=sys.stderr)
        return 2

    def progress(done, total):
        print(f"\r{done / 1_000_000:.0f} / {total / 1_000_000:.0f} MB", end="", file=sys.stderr)

    path = download_model(model, progress)
    print(f"\nsaved {path}", file=sys.stderr)
    return 0


def main():
    if "--download" in sys.argv:
        index = sys.argv.index("--download")
        return download_from_command_line(sys.argv[index + 1] if index + 1 < len(sys.argv) else "")
    application = Adw.Application(
        application_id="org.freedesktop.IBus.AzooKey.Setup",
        flags=Gio.ApplicationFlags.NON_UNIQUE if "--self-test" in sys.argv else Gio.ApplicationFlags.DEFAULT_FLAGS,
    )
    if "--self-test" in sys.argv:
        directory = tempfile.mkdtemp(prefix="azookey-setup-test-")
        os.environ["AZOOKEY_IBUS_CONFIG_DIR"] = directory
        os.environ["AZOOKEY_IBUS_DATA_DIR"] = directory
        application.connect("activate", self_test)
    else:
        application.connect("activate", lambda app: (app.props.active_window or SettingsWindow(app)).present())
    return application.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
