#!/usr/bin/python3
"""Settings window for ibus-azookey, an unofficial IBus port of azooKey.

Every change is written to ~/.config/ibus-azookey/config.json right away; the
engine re-reads the file the next time a text field gets focus. GNOME opens
this from Settings > Keyboard > Input Sources > azooKey > Preferences, and the
engine's status menu has a "設定…" item for it.

Zenzai models listed in data/models.json that are not installed are
downloaded when selected, into ~/.local/share/ibus-azookey/models, and checked
against the catalog's SHA-256.

--self-test builds the window without showing it and checks that changes are
saved (needs a display, writes into a temporary directory).
--download MODEL_ID downloads a model without opening the window.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import urllib.request
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

HERE = Path(__file__).resolve().parent
ENGINE = HERE / "ibus-engine-azookey"

# (value stored in config.json, label shown)
LEARNING = [
    ("inputAndOutput", "学習する"),
    ("onlyOutput", "学習結果を使うだけ (更新しない)"),
    ("nothing", "学習しない"),
]
INPUT_STYLES = [
    ("roman", "ローマ字入力"),
    ("azik", "AZIK"),
    ("kanaUS", "かな入力 (US配列)"),
    ("kanaJIS", "かな入力 (JIS配列)"),
]
PUNCTUATION = [
    ("kutenAndToten", "。、"),
    ("kutenAndComma", "。，"),
    ("periodAndToten", "．、"),
    ("periodAndComma", "．，"),
]
MODEL_FILE = "ggml-model-Q5_K_M.gguf"


def xdg_directory(override, variable, fallback):
    """Mirrors Paths.swift so both sides agree on locations."""
    if os.environ.get(override):
        return Path(os.environ[override])
    base = os.environ.get(variable, "")
    return (Path(base) if base.startswith("/") else Path.home() / fallback) / "ibus-azookey"


def config_file():
    return xdg_directory("AZOOKEY_IBUS_CONFIG_DIR", "XDG_CONFIG_HOME", ".config") / "config.json"


def reset_request_file():
    return xdg_directory("AZOOKEY_IBUS_DATA_DIR", "XDG_DATA_HOME", ".local/share") / "reset-learning-request"


def share_directory():
    share = os.environ.get("AZOOKEY_IBUS_SHARE_DIR")
    return Path(share) if share else HERE.parent.parent / "share" / "ibus-azookey"


def user_models_directory():
    return xdg_directory("AZOOKEY_IBUS_DATA_DIR", "XDG_DATA_HOME", ".local/share") / "models"


def load_catalog():
    """data/models.json as installed, or from the source tree when run there."""
    for path in (share_directory() / "models.json", HERE.parent / "data" / "models.json"):
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
    return []


def installed_location(model):
    """Where the engine will find the model (downloads first), or None."""
    for root in (user_models_directory(), share_directory() / "models"):
        if (root / model["id"] / MODEL_FILE).exists():
            return root
    return None


def apache_license_text():
    for path in (HERE.parent.parent / "share" / "doc" / "ibus-azookey" / "licenses" / "Apache-2.0.txt",
                 HERE.parent / "data" / "licenses" / "Apache-2.0.txt"):
        if path.exists():
            return path.read_text(encoding="utf-8")
    return "Apache License 2.0: https://www.apache.org/licenses/LICENSE-2.0.txt\n"


class DownloadCancelled(Exception):
    pass


def download_model(model, progress=lambda done, total: None, cancelled=None):
    """Downloads into the user's models directory and verifies the SHA-256.
    Runs on a worker thread; `progress` gets bytes done and the total."""
    destination = user_models_directory() / model["id"]
    destination.mkdir(parents=True, exist_ok=True)
    target = destination / MODEL_FILE
    partial = target.with_name(target.name + ".part")
    url = f"https://huggingface.co/{model['repo']}/resolve/{model['revision']}/{model['file']}"
    digest = hashlib.sha256()
    done = 0
    try:
        with urllib.request.urlopen(url, timeout=30) as response, open(partial, "wb") as out:
            total = int(response.headers.get("Content-Length") or model["size"])
            while chunk := response.read(1 << 16):
                if cancelled is not None and cancelled.is_set():
                    raise DownloadCancelled()
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                progress(done, total)
        if digest.hexdigest() != model["sha256"]:
            raise ValueError("the download is corrupted (SHA-256 mismatch)")
        os.replace(partial, target)
    finally:
        partial.unlink(missing_ok=True)
    # The model repositories only carry a license tag; keep license and provenance.
    if model["license"] == "Apache-2.0":
        (destination / "LICENSE").write_text(apache_license_text(), encoding="utf-8")
    else:
        (destination / "LICENSE").write_text(
            f"{model['license']}: https://creativecommons.org/licenses/by-sa/4.0/\n", encoding="utf-8")
    (destination / "SOURCE").write_text(
        f"Model:    {model['repo']}\nRevision: {model['revision']}\n"
        f"File:     {model['file']} (SHA-256 {model['sha256']})\n"
        f"Author:   Miwa Keita (https://huggingface.co/Miwa-Keita)\n"
        f"License:  {model['license']}\nChanges:  none; redistributed unmodified.\n",
        encoding="utf-8")
    return target


def load_settings():
    """The effective settings, defaults included, as the engine sees them."""
    try:
        result = subprocess.run(
            [str(ENGINE), "--dump-settings"], capture_output=True, text=True, timeout=10, check=True
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(f"ibus-setup-azookey: cannot ask {ENGINE} for settings: {error}", file=sys.stderr)
    try:
        return json.loads(config_file().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def engine_version():
    """The installed engine's version, like "0.1.4", or None."""
    try:
        result = subprocess.run(
            [str(ENGINE), "--version"], capture_output=True, text=True, timeout=10, check=True
        )
        return result.stdout.split()[-1]
    except (OSError, subprocess.SubprocessError, IndexError):
        return None


def outdated_engine_running(engine=ENGINE):
    """Whether an engine started before the package was upgraded still runs.
    Upgrading replaces the file, so the kernel shows the running one as deleted."""
    replaced = f"{engine} (deleted)"
    for link in Path("/proc").glob("[0-9]*/exe"):
        try:
            if os.readlink(link) == replaced:
                return True
        except OSError:  # another user's process, or it just exited
            continue
    return False


def save_settings(settings):
    path = config_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(settings, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temporary, path)


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title="azooKey の設定", default_width=600, default_height=760)
        self.settings = load_settings()
        self.rows = {}

        page = Adw.PreferencesPage()

        learning = Adw.PreferencesGroup(
            title="学習",
            description="選んだ変換候補を覚えて、次から上位に出します (Learning)",
        )
        learning.add(self.combo_row("learning", "学習モード", LEARNING))
        reset_row = Adw.ActionRow(title="学習データをリセット", subtitle="これまでの学習内容を消去します")
        reset_button = Gtk.Button(label="リセット…", valign=Gtk.Align.CENTER)
        reset_button.add_css_class("destructive-action")
        reset_button.connect("clicked", self.on_reset_clicked)
        reset_row.add_suffix(reset_button)
        learning.add(reset_row)
        page.add(learning)

        conversion = Adw.PreferencesGroup(title="変換", description="Conversion")
        conversion.add(self.switch_row(
            "liveConversion", "ライブ変換", "入力中に変換結果を表示する。オフならスペースで変換 (Live conversion)"))
        conversion.add(self.combo_row("inputStyle", "入力方式", INPUT_STYLES))
        conversion.add(self.combo_row("punctuationStyle", "句読点", PUNCTUATION))
        conversion.add(self.switch_row(
            "typeHalfSpace", "スペースを半角で入力", "オフなら全角スペース。Shift+スペースで反対の幅"))
        conversion.add(self.switch_row(
            "typeBackSlash", "バックスラッシュキーで \\ を入力", "オフなら ¥ を入力"))
        conversion.add(self.spin_row("candidatePageSize", "1ページの候補数", 1, 10))
        page.add(conversion)

        zenzai = Adw.PreferencesGroup(
            title="Zenzai (ニューラルかな漢字変換)",
            description="zenzモデルで文脈に合った変換をします。CPUで動作します",
        )
        zenzai.add(self.switch_row("zenzaiEnabled", "Zenzai を使う", "オフにすると辞書だけで変換します"))
        self.add_model_rows(zenzai)
        zenzai.add(self.spin_row(
            "zenzaiInferenceLimit", "推論回数の上限", 1, 20, "大きいほど精度が上がり、遅くなります (既定: 5)"))
        zenzai.add(self.entry_row("zenzaiProfile", "プロフィール (例: エンジニア/Swift開発者)"))
        zenzai.add(self.switch_row(
            "useSurroundingText", "前後の文章を文脈に使う", "カーソルの前後にある文章を変換の手がかりにします"))
        page.add(zenzai)

        about = Adw.PreferencesGroup(title="このソフトウェアについて")
        about.add(Adw.ActionRow(
            title="ibus-azookey (非公式)",
            subtitle="AzooKeyKanaKanjiConverter と zenz-v3.2 モデルを使っています。"
                     "ライセンス: /usr/share/doc/ibus-azookey",
        ))
        about.add(self.version_row())
        page.add(about)

        self.toasts = Adw.ToastOverlay(child=page)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(self.toasts)
        self.set_content(toolbar)
        self.connect("close-request", self.on_close_request)

    def version_row(self):
        version = engine_version()
        row = Adw.ActionRow(title="バージョン")
        self.version_label = Gtk.Label(label=version or "不明", selectable=True)
        self.version_label.add_css_class("dim-label")
        row.add_suffix(self.version_label)
        if version is not None and outdated_engine_running():
            row.set_subtitle("このバージョンに更新済みです。ログインし直すか ibus restart を実行すると切り替わります")
        return row

    def on_close_request(self, _window):
        if self.cancel_download is not None:
            self.cancel_download.set()
        return False

    # ---- Zenzai model selector ----

    def add_model_rows(self, group):
        self.catalog = load_catalog()
        self.updating_models = False
        self.cancel_download = None
        selected = self.settings.get("zenzaiModel", "zenz-v3.2-small")
        if selected in ("small", "xsmall"):
            selected = f"zenz-v3.2-{selected}"
        self.model_list = Gtk.StringList.new([self.model_label(model) for model in self.catalog])
        row = Adw.ComboRow(
            title="モデル", subtitle="インストールされていないモデルは、選ぶとダウンロードします", model=self.model_list)
        ids = [model["id"] for model in self.catalog]
        if selected in ids:
            row.set_selected(ids.index(selected))
        self.model_index = row.get_selected()
        row.connect("notify::selected", self.on_model_selected)
        self.rows["zenzaiModel"] = row
        group.add(row)

        self.download_row = Adw.ActionRow(visible=False)
        self.download_bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER, hexpand=True, show_text=True)
        cancel = Gtk.Button(label="キャンセル", valign=Gtk.Align.CENTER)
        cancel.connect("clicked", lambda _: self.cancel_download and self.cancel_download.set())
        self.download_row.add_suffix(self.download_bar)
        self.download_row.add_suffix(cancel)
        group.add(self.download_row)

    @staticmethod
    def model_label(model):
        location = installed_location(model)
        if location is None:
            status = f"ダウンロード {model['size'] / 1_000_000:.0f} MB"
        elif location == user_models_directory():
            status = "ダウンロード済み"
        else:
            status = "同梱"
        return f"{model['label']} — {status}"

    def select_model_quietly(self, index):
        self.updating_models = True
        self.model_list.splice(0, self.model_list.get_n_items(), [self.model_label(m) for m in self.catalog])
        self.rows["zenzaiModel"].set_selected(index)
        self.updating_models = False

    def on_model_selected(self, row, _):
        index = row.get_selected()
        if self.updating_models or index == self.model_index or index >= len(self.catalog):
            return
        model = self.catalog[index]
        if installed_location(model) is not None:
            self.model_index = index
            self.set_value("zenzaiModel", model["id"])
            return
        # Keep the current model selected until the download has finished.
        self.select_model_quietly(self.model_index)
        self.confirm_download(model, index)

    def confirm_download(self, model, index):
        body = f"{model['size'] / 1_000_000:.0f} MB を Hugging Face からダウンロードします。ライセンス: {model['license']}"
        if model["license"] != "Apache-2.0":
            body += "\n旧世代のモデルです。ほかの人に配布する場合は CC BY-SA 4.0 に従ってください。"
        dialog = Adw.AlertDialog(heading=f"{model['label']} をダウンロードしますか？", body=body)
        dialog.add_response("cancel", "キャンセル")
        dialog.add_response("download", "ダウンロード")
        dialog.set_response_appearance("download", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("download")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, response: response == "download" and self.start_download(model, index))
        dialog.present(self)

    def start_download(self, model, index):
        self.cancel_download = threading.Event()
        self.rows["zenzaiModel"].set_sensitive(False)
        self.download_row.set_title(f"{model['label']} をダウンロード中")
        self.download_bar.set_fraction(0)
        self.download_row.set_visible(True)
        last_percent = [-1]

        def progress(done, total):
            percent = done * 100 // max(total, 1)
            if percent != last_percent[0]:
                last_percent[0] = percent
                GLib.idle_add(self.show_progress, done, total)

        def work(cancelled):
            try:
                download_model(model, progress, cancelled)
                GLib.idle_add(self.download_finished, model, index, None)
            except Exception as error:  # reported in the window
                GLib.idle_add(self.download_finished, model, index, error)

        threading.Thread(target=work, args=(self.cancel_download,), daemon=True).start()

    def show_progress(self, done, total):
        self.download_bar.set_fraction(done / max(total, 1))
        self.download_bar.set_text(f"{done / 1_000_000:.0f} / {total / 1_000_000:.0f} MB")
        return GLib.SOURCE_REMOVE

    def download_finished(self, model, index, error):
        self.cancel_download = None
        self.download_row.set_visible(False)
        self.rows["zenzaiModel"].set_sensitive(True)
        if error is None:
            self.model_index = index
            self.select_model_quietly(index)
            self.set_value("zenzaiModel", model["id"])
            self.toasts.add_toast(Adw.Toast(title=f"{model['label']} を使います (次の入力から)"))
        else:
            self.select_model_quietly(self.model_index)
            message = "キャンセルしました" if isinstance(error, DownloadCancelled) else f"ダウンロードできませんでした: {error}"
            self.toasts.add_toast(Adw.Toast(title=message))
        return GLib.SOURCE_REMOVE

    # Rows are connected after their initial value is set, so building the
    # window never writes the file.

    def switch_row(self, key, title, subtitle=""):
        row = Adw.SwitchRow(title=title, subtitle=subtitle, active=bool(self.settings.get(key)))
        row.connect("notify::active", lambda widget, _: self.set_value(key, widget.get_active()))
        self.rows[key] = row
        return row

    def combo_row(self, key, title, choices):
        values = [value for value, _ in choices]
        row = Adw.ComboRow(title=title, model=Gtk.StringList.new([label for _, label in choices]))
        if self.settings.get(key) in values:
            row.set_selected(values.index(self.settings[key]))
        row.connect("notify::selected", lambda widget, _: self.set_value(key, values[widget.get_selected()]))
        self.rows[key] = row
        return row

    def spin_row(self, key, title, lower, upper, subtitle=""):
        row = Adw.SpinRow.new_with_range(lower, upper, 1)
        row.set_title(title)
        row.set_subtitle(subtitle)
        row.set_value(self.settings.get(key, lower))
        row.connect("notify::value", lambda widget, _: self.set_value(key, int(widget.get_value())))
        self.rows[key] = row
        return row

    def entry_row(self, key, title):
        row = Adw.EntryRow(title=title, show_apply_button=True, text=self.settings.get(key, ""))
        row.connect("apply", lambda widget: self.set_value(key, widget.get_text().strip()))
        self.rows[key] = row
        return row

    def set_value(self, key, value):
        if self.settings.get(key) == value:
            return
        self.settings[key] = value
        try:
            save_settings(self.settings)
        except OSError as error:
            self.toasts.add_toast(Adw.Toast(title=f"保存できませんでした: {error}"))

    def on_reset_clicked(self, _button):
        dialog = Adw.AlertDialog(
            heading="学習データをリセットしますか？",
            body="これまでに覚えた変換候補の順位がすべて消えます。元には戻せません。",
        )
        dialog.add_response("cancel", "キャンセル")
        dialog.add_response("reset", "リセット")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", self.on_reset_response)
        dialog.present(self)

    def on_reset_response(self, _dialog, response):
        if response != "reset":
            return
        self.request_learning_reset()
        self.toasts.add_toast(Adw.Toast(title="次に文字を入力するときに学習データがリセットされます"))

    @staticmethod
    def request_learning_reset():
        request = reset_request_file()
        request.parent.mkdir(parents=True, exist_ok=True)
        request.touch()


def self_test(application):
    window = SettingsWindow(application)
    assert not config_file().exists(), "building the window must not write settings"
    window.rows["learning"].set_selected(2)
    window.rows["liveConversion"].set_active(not window.rows["liveConversion"].get_active())
    window.rows["zenzaiInferenceLimit"].set_value(3)
    saved = json.loads(config_file().read_text(encoding="utf-8"))
    assert saved["learning"] == "nothing", saved
    assert saved["zenzaiInferenceLimit"] == 3, saved
    SettingsWindow.request_learning_reset()
    assert reset_request_file().exists()

    # Model selector: every catalog model is listed; picking an installed one
    # saves it, picking a missing one keeps the current model (and would ask
    # before downloading).
    models = window.rows["zenzaiModel"]
    ids = [model["id"] for model in window.catalog]
    assert "zenz-v3.2-small" in ids and "zenz-v3.2-xsmall" in ids, ids
    fake = user_models_directory() / "zenz-v3.2-xsmall"
    fake.mkdir(parents=True)
    (fake / MODEL_FILE).write_bytes(b"")
    window.select_model_quietly(window.model_index)
    assert "ダウンロード済み" in window.model_list.get_string(ids.index("zenz-v3.2-xsmall"))
    models.set_selected(ids.index("zenz-v3.2-xsmall"))
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiModel"] == "zenz-v3.2-xsmall"
    window.confirm_download = lambda model, index: None
    models.set_selected(ids.index("zenz-v3.1-small"))
    assert models.get_selected() == ids.index("zenz-v3.2-xsmall"), "a missing model must not be selected yet"
    assert json.loads(config_file().read_text(encoding="utf-8"))["zenzaiModel"] == "zenz-v3.2-xsmall"

    # Version row: the engine next to this script reports it (none in the source tree).
    version = window.version_label.get_label()
    if ENGINE.exists():
        assert re.fullmatch(r"\d+(\.\d+)+", version), f"version row shows {version!r}"
    # A running program whose file was replaced, as an upgrade does, counts as outdated.
    program = Path(tempfile.mkdtemp()).resolve() / "sleep"
    shutil.copy(shutil.which("sleep"), program)
    process = subprocess.Popen([str(program), "30"])
    try:
        assert not outdated_engine_running(program)
        program.unlink()
        assert outdated_engine_running(program), "a replaced running program must count as outdated"
    finally:
        process.kill()
        process.wait()
        shutil.rmtree(program.parent)
    print(f"self-test ok: {len(window.rows)} settings rows, {len(ids)} models, version {version}")
    shutil.rmtree(config_file().parent)
    application.quit()


def download_from_command_line(model_id):
    model = next((m for m in load_catalog() if m["id"] == model_id), None)
    if model is None:
        print(f"unknown model {model_id}; choose from: {', '.join(m['id'] for m in load_catalog())}", file=sys.stderr)
        return 2

    def progress(done, total):
        print(f"\r{done / 1_000_000:.0f} / {total / 1_000_000:.0f} MB", end="", file=sys.stderr)

    path = download_model(model, progress)
    print(f"\nsaved {path}", file=sys.stderr)
    return 0


def main():
    if "--download" in sys.argv:
        index = sys.argv.index("--download")
        return download_from_command_line(sys.argv[index + 1] if index + 1 < len(sys.argv) else "")
    application = Adw.Application(
        application_id="org.freedesktop.IBus.AzooKey.Setup",
        flags=Gio.ApplicationFlags.NON_UNIQUE if "--self-test" in sys.argv else Gio.ApplicationFlags.DEFAULT_FLAGS,
    )
    if "--self-test" in sys.argv:
        directory = tempfile.mkdtemp(prefix="azookey-setup-test-")
        os.environ["AZOOKEY_IBUS_CONFIG_DIR"] = directory
        os.environ["AZOOKEY_IBUS_DATA_DIR"] = directory
        application.connect("activate", self_test)
    else:
        application.connect("activate", lambda app: (app.props.active_window or SettingsWindow(app)).present())
    return application.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
