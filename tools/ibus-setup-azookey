]
MODEL_FILE = "ggml-model-Q5_K_M.gguf"
LOCAL_MODEL = "local"  # ModelCatalog.localModelID


def xdg_directory(override, variable, fallback):
    """Mirrors Paths.swift so both sides agree on locations."""
    if os.environ.get(override):
        return Path(os.environ[override])
    base = os.environ.get(variable, "")
    return (Path(base) if base.startswith("/") else Path.home() / fallback) / "ibus-azookey"


def config_file():
    return xdg_directory("AZOOKEY_IBUS_CONFIG_DIR", "XDG_CONFIG_HOME", ".config") / "config.json"


def reset_request_file():
    return xdg_directory("AZOOKEY_IBUS_DATA_DIR", "XDG_DATA_HOME", ".local/share") / "reset-learning-request"


def share_directory():
    share = os.environ.get("AZOOKEY_IBUS_SHARE_DIR")
    return Path(share) if share else HERE.parent.parent / "share" / "ibus-azookey"


def user_models_directory():
    return xdg_directory("AZOOKEY_IBUS_DATA_DIR", "XDG_DATA_HOME", ".local/share") / "models"


def load_catalog():
    """data/models.json as installed, or from the source tree when run there."""
    for path in (share_directory() / "models.json", HERE.parent / "data" / "models.json"):
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
    return []


def installed_location(model):
    """Where the engine will find the model (downloads first), or None."""
    for root in (user_models_directory(), share_directory() / "models"):
        if (root / model["id"] / MODEL_FILE).exists():
            return root
    return None


def outdated(model):
    """Whether the downloaded copy is an older file than the catalog's: the
    SOURCE file written with it records the SHA-256 it was checked against.
    Models installed with the package are always current."""
    if installed_location(model) != user_models_directory():
        return False
    try:
        source = (user_models_directory() / model["id"] / "SOURCE").read_text(encoding="utf-8")
    except OSError:
        return False  # placed there by hand
    return model["sha256"] not in source


def is_gguf(path):
    try:
        with open(path, "rb") as file:
            return file.read(4) == b"GGUF"
    except OSError:
        return False


def apache_license_text():
    for path in (HERE.parent.parent / "share" / "doc" / "ibus-azookey" / "licenses" / "Apache-2.0.txt",
                 HERE.parent / "data" / "licenses" / "Apache-2.0.txt"):
        if path.exists():
            return path.read_text(encoding="utf-8")
    return "Apache License 2.0: https://www.apache.org/licenses/LICENSE-2.0.txt\n"


class DownloadCancelled(Exception):
    pass


def model_url(model):
    """A catalog entry's "url", else its Hugging Face file at the pinned revision."""
    return model.get("url") or f"https://huggingface.co/{model['repo']}/resolve/{model['revision']}/{model['file']}"


def model_source(model):
    """The SOURCE file kept next to a downloaded model."""
    origin = (f"URL:      {model['url']}\n" if model.get("url")
              else f"Model:    {model['repo']}\nRevision: {model['revision']}\n")
    return (f"{origin}File:     {model['file']} (SHA-256 {model['sha256']})\n"
            f"Author:   {model.get('author', 'Miwa Keita (https://huggingface.co/Miwa-Keita)')}\n"
            f"License:  {model['license']} (see LICENSE)\n"
            f"Changes:  {model.get('changes', 'none; redistributed unmodified.')}\n")


def download_model(model, progress=lambda done, total: None, cancelled=None):
    """Downloads into the user's models directory and verifies the SHA-256.
    Runs on a worker thread; `progress` gets bytes done and the total."""
    destination = user_models_directory() / model["id"]
    destination.mkdir(parents=True, exist_ok=True)
    target = destination / MODEL_FILE
    partial = target.with_name(target.name + ".part")
    digest = hashlib.sha256()
    done = 0
    try:
        with urllib.request.urlopen(model_url(model), timeout=30) as response, open(partial, "wb") as out:
            total = int(response.headers.get("Content-Length") or model["size"])
            while chunk := response.read(1 << 16):
                if cancelled is not None and cancelled.is_set():
                    raise DownloadCancelled()
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                progress(done, total)
        if digest.hexdigest() != model["sha256"]:
            raise ValueError("the download is corrupted (SHA-256 mismatch)")
        os.replace(partial, target)
    finally:
        partial.unlink(missing_ok=True)
    # The model repositories only carry a license tag; keep license and provenance.
    if model["license"] == "Apache-2.0":
        (destination / "LICENSE").write_text(apache_license_text(), encoding="utf-8")
    else:
        (destination / "LICENSE").write_text(
            f"{model['license']}: https://creativecommons.org/licenses/by-sa/4.0/\n", encoding="utf-8")
    (destination / "SOURCE").write_text(model_source(model), encoding="utf-8")
    return target


def load_settings():
    """The effective settings, defaults included, as the engine sees them."""
    try:
        result = subprocess.run(
            [str(ENGINE), "--dump-settings"], capture_output=True, text=True, timeout=10, check=True
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(f"ibus-setup-azookey: cannot ask {ENGINE} for settings: {error}", file=sys.stderr)
    try:
        return json.loads(config_file().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def engine_version():
    """The installed engine's version, like "0.1.4", or None."""
    try:
        result = subprocess.run(
            [str(ENGINE), "--version"], capture_output=True, text=True, timeout=10, check=True
        )
        return result.stdout.split()[-1]
    except (OSError, subprocess.SubprocessError, IndexError):
        return None


def outdated_engine_running(engine=ENGINE):
    """Whether an engine started before the package was upgraded still runs.
    Upgrading replaces the file, so the kernel shows the running one as deleted."""
    replaced = f"{engine} (deleted)"
    for link in Path("/proc").glob("[0-9]*/exe"):
        try:
            if os.readlink(link) == replaced:
                return True
        except OSError:  # another user's process, or it just exited
            continue
    return False


def save_settings(settings):
    path = config_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(settings, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temporary, path)


